# ------------------------------------------------------------
# OSOBAU – Apache-Konfiguration (Standard-Webhosting)
# ------------------------------------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + www erzwingen (bei Bedarf anpassen)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.osobau.de%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^osobau\.de$ [NC]
  RewriteRule ^ https://www.osobau.de%{REQUEST_URI} [L,R=301]

  # Single-Page-App: alle Routen auf index.html, außer echte Dateien/Ordner
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Lange Cache-Zeiten für gehashte Assets und Bilder
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
