# Öffentliche Basis-URL (ohne abschließenden Slash) – für Canonical-Tags & Open Graph
VITE_SITE_URL=https://www.osobau.de

# Endpunkt des Kontaktformulars.
#   /api/contact.php  → mitgeliefertes PHP-Skript (Standard-Webhosting mit PHP 8.1+)
#   leer lassen       → Formular zeigt deutlich an, dass der Versand noch nicht angebunden ist
VITE_CONTACT_ENDPOINT=/api/contact.php
